# ============================================================
# AI Life Manager — Backend Environment Variables
# Copy this file to `.env` and fill in real values.
# NEVER commit the actual `.env` file.
# ============================================================

# --- App ---
APP_NAME=AI Life Manager
APP_ENV=development                 # development | production
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Database ---
# Development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./ai_life_manager.db
# Production (PostgreSQL / Neon example):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# --- Auth / JWT ---
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- LLM (Anthropic) ---
ANTHROPIC_API_KEY=CHANGE_ME
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Weather (Open-Meteo — no key required, listed for clarity) ---
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# --- MCP Server ---
MCP_SERVER_TRANSPORT=streamable-http   # stdio | sse | streamable-http
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8001

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute

# --- Logging ---
LOG_LEVEL=INFO
